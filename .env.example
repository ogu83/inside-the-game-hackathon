# Copy to .env and fill in. .env is gitignored; never commit real values.
# Auth is keyless (DefaultAzureCredential via `az login`), so no API keys here.

# Microsoft Foundry project endpoint (portal: project overview page)
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# Model deployment names in the Foundry project (pinned in T2)
FRONTIER_MODEL_DEPLOYMENT=<frontier-deployment-name>
SMALL_MODEL_DEPLOYMENT=<small-deployment-name>

# Local app
APP_PORT=8010
