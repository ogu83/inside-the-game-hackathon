# Copy to .env and fill in. .env is gitignored; never commit real secrets or credentials.
# Authentication is keyless (DefaultAzureCredential via az login locally or Managed Identity in Azure).

# Microsoft Foundry project endpoint (from Foundry portal project overview)
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# Model deployment names in the Foundry project
FRONTIER_MODEL_DEPLOYMENT=gpt-5.4-mini
SMALL_MODEL_DEPLOYMENT=gpt-5.4-mini

# Voice Live model deployments for verbatim speech and push-to-talk listening
VOICE_LIVE_MODEL=gpt-5.4-mini
VOICE_TRANSCRIBE_MODEL=azure-speech

# Azure Application Insights connection string for OpenTelemetry tracing
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Local server port
APP_PORT=8010

# Agents execution mode: template (offline, no Azure) or foundry (live models from deployments above)
AGENT_MODE=template

# Voice Live mode: voicelive (streams audio via Foundry Voice Live) or off
VOICE_MODE=off

# Broadcast delay in match seconds for live agent execution (SPEC design rule 1)
BROADCAST_DELAY_S=20

# Live match runs allowed per visitor IP per day on public instance (0 = unlimited for local dev)
PUBLIC_LIVE_RUNS_PER_DAY=2

# Global daily spend protection cap on live runs across all visitors (0 = unlimited)
PUBLIC_LIVE_RUNS_TOTAL_PER_DAY=40

# Maximum concurrent match runs permitted across all visitors
MAX_CONCURRENT_RUNS=4

# Idle match session time-to-live before reaper cleanup (seconds)
RUN_IDLE_TTL_S=600

# OpenTelemetry distributed tracing: true to export spans to Application Insights
TRACING=false

# Include prompt text and tool arguments in exported OpenTelemetry spans: true or false
TRACE_SENSITIVE=false

# Enable demo switch for Scene 5 planted-claim rejection demonstration (1 = enabled, 0 = disabled)
DEMO_PLANT=0

# Public base URL of the deployment (leave blank to infer from incoming requests)
PUBLIC_BASE_URL=

# Note on Azure runtime:
# CONTAINER_APP_NAME, IDENTITY_ENDPOINT, MSI_ENDPOINT, and WEBSITE_INSTANCE_ID
# are provided automatically by Azure Container Apps runtime for Managed Identity.
