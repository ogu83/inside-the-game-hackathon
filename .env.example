# Copy to .env and fill in. .env is gitignored; never commit real values.
# Auth is keyless (DefaultAzureCredential via `az login`), so no API keys here.

# Microsoft Foundry project endpoint (portal: project overview page).
# Name matches what Agent Framework's FoundryChatClient reads.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# Model deployment names in the Foundry project
FRONTIER_MODEL_DEPLOYMENT=<frontier-deployment-name>
SMALL_MODEL_DEPLOYMENT=<small-deployment-name>

# Local app
APP_PORT=8010

# Agents: template (offline, no Azure) or foundry (live models from the deployments above)
AGENT_MODE=template
# Voice Live: voicelive (needs FOUNDRY_PROJECT_ENDPOINT) or off
VOICE_MODE=voicelive
# Broadcast delay in match seconds (SPEC design rule 1)
BROADCAST_DELAY_S=20
# Live matches per visitor per day on the public app (design rule 7); 0 = unlimited for local development
PUBLIC_LIVE_RUNS_PER_DAY=2
